# Google Gemini AI API Key (Required for LLM, Roadmap, Profile, and Interview Chat)
GEMINI_API_KEY=AIzaSy...

# Tavily Search API Key (Required for Live Web & Job Market Search)
TAVILY_API_KEY=tvly-...

# Clerk Secret Key (Required for backend JWT token verification)
CLERK_SECRET_KEY=sk_test_...

# Optional: Frontend URL for CORS (Vercel subdomains *.vercel.app are automatically permitted)
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: Redis URL for caching (If omitted, runs with fallback memory cache)
REDIS_URL=redis://localhost:6379
